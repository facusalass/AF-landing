---
import "../styles/global.css";
import Header from "../components/Header.astro";

const siteUrl = Astro.site ? new URL(Astro.site) : new URL("https://example.com");
---

<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>Página no encontrada | AFdevelopers</title>
  </head>

  <body class="min-h-screen text-white selection:bg-indigo-500/30 overflow-x-hidden">
    <div class="fixed inset-0 z-0 bg-slate-900">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(129,140,248,0.12),transparent)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_100%_100%,rgba(34,211,238,0.08),transparent)]"></div>
    </div>

    <div class="relative z-10">
      <div class="py-8 sm:py-10">
        <Header rightInicio="Inicio" rightConocenos="Conócenos" conocenosHref="/#conoce-af" rightinfo="Trabajos" rightCta="Contactanos" ctaHref="/#contacto" />
      </div>

      <main class="flex items-center justify-center min-h-[70vh]">
        <div class="text-center px-5 max-w-lg">
          <p class="font-mont text-8xl sm:text-9xl font-bold text-indigo-400/30 select-none">404</p>
          <h1 class="font-mont text-2xl sm:text-3xl font-semibold text-white mt-4">
            Página no encontrada
          </h1>
          <p class="font-poppins text-neutral-300 mt-4 leading-relaxed">
            La página que buscás no existe o fue movida. Volvé al inicio para conocer cómo podemos ayudarte con software a medida.
          </p>
          <a
            href="/"
            class="mt-8 inline-flex items-center rounded-full bg-gradient-to-r from-indigo-400 to-cyan-400 px-6 py-3 text-slate-900 font-semibold font-poppins hover:from-indigo-300 hover:to-cyan-300 transition-colors"
          >
            Ir al inicio
          </a>
        </div>
      </main>
    </div>
  </body>
</html>
